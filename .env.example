# Postgres connection string. docker-compose.yml's default `db` service matches this.
DATABASE_URL=postgresql+psycopg://fleetportal:fleetportal@localhost:5432/fleetportal

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ADMIN_USERNAME=admin

# Generate with: flask hash-password
ADMIN_PASSWORD_HASH=

FLASK_DEBUG=1

# Fleet Portal status polling (Phase 2) — encrypts Controller.fleet_api_token
# at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLEET_TOKEN_ENCRYPTION_KEY=

# Optional overrides (defaults shown):
# FLEET_POLL_INTERVAL_SECONDS=60
# FLEET_POLL_TIMEOUT_SECONDS=8
# FLEET_OBIX_PORT=8061
# FLEET_POLLER_ENABLED=1
# BILLING_SCHEDULER_ENABLED=1
# BILLING_SCHEDULER_INTERVAL_SECONDS=86400

# Stripe payment processor (Phase 5) — optional. Leave both unset to run
# without Stripe (the invoice/pay-by-hand workflow keeps working
# unchanged). Get these from the Stripe Dashboard -> Developers -> API
# keys / Webhooks (or `stripe listen` for local testing).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Tailscale for adopted modules (optional; app/tailscale_api.py). Set with
# deploy/set-tailscale-oauth.sh rather than by hand. Unset = adoption polls
# the module's LAN address.
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=
# TAILSCALE_TAGS=tag:controller
# TAILSCALE_KEY_TTL_SECONDS=3600

# Off-site backup (deploy/backup-db.sh): dump + .env, encrypted to the
# master age PUBLIC key, pushed to a private repo with a write deploy key.
# FLEET_OFFSITE_REPO=git@github.com:<owner>/echotherm-portal-backups.git
# FLEET_OFFSITE_RECIPIENT=age1...
# FLEET_OFFSITE_SSH_KEY=~/.ssh/fleet_portal_backup
